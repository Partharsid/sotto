{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "noEmit": false,
    "isolatedModules": false,
    "types": ["node"]
  },
  "include": ["src/main/**/*", "src/server/**/*"]
}
