# Optional. Keys can also be pasted into the app (Settings). Keys here are read only by the local server.

# Answers — set ONE of these (free tiers exist for both):
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free   # raced; first answer wins
GEMINI_API_KEY=
# …or any OpenAI-compatible API:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=llama-3.1-8b-instant

# Cloud speech-to-text (only if you don't use the on-device engine). Any Whisper-compatible API:
# STT_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
